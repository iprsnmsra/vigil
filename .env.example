# Vigil Platform Environment Variables (Example Template)
# Copy this file to .env and insert your real credentials.

# Google Gemini API key for automated incident root-cause postmortems
GEMINI_API_KEY=your_gemini_api_key_here
VIGIL_GEMINI_API_KEY=your_gemini_api_key_here

# Controller Configuration
VIGIL_LLM_ENABLED=true
VIGIL_DRY_RUN=true
VIGIL_MAX_ACTIONS_PER_HOUR=10

# GitHub Integration (Optional - for auto-creating issues and quarantine PRs)
VIGIL_GITHUB_TOKEN=your_github_token_here
